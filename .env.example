# Supabase Configuration
# Get these from https://app.supabase.com > Project Settings > API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# These are CLIENT-SIDE variables (safe to expose)
# Never put sensitive secrets here

# Optional: set the Supabase schema if your project uses a custom schema.
# Default is public.
VITE_SUPABASE_SCHEMA=public

# Paystack configuration
# Use a public key in frontend only.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx

# Supabase Edge Functions base URL used by frontend to initialize and verify Paystack payments.
VITE_SUPABASE_FUNCTIONS_URL=https://your-project-ref.functions.supabase.co

# Server-only secret keys should be stored in your Supabase Edge Functions environment,
# not in client-side env files.
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here
